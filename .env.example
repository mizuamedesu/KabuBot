# Optional Codex model override.
CODEX_MODEL=

# Market scan defaults.
SECTOR_QUERY=ソフトウェア
MAX_CANDIDATES=45
MARKET_TIMEZONE=America/New_York
MARKET_OPEN_SCAN_CRON=32 9 * * 1-5
RUN_ON_START=false

# Grok X live search. Required for X social narrative analysis.
XAI_API_KEY=
GROK_MODEL=grok-3-mini
GROK_QUERY_DAYS=2

# Discord bot. Invite this bot to any server. The user/channel are bound by Codex auth in Discord.
DISCORD_BOT_TOKEN=

# Optional webhook notifications. Webhook only posts reports; it cannot chat.
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
