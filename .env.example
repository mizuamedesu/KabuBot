# Optional Codex model override.
CODEX_MODEL=

# Market scan defaults.
SECTOR_QUERY=ソフトウェア
MAX_CANDIDATES=45
MARKET_TIMEZONE=America/New_York
MARKET_OPEN_SCAN_CRON=32 9 * * 1-5
RUN_ON_START=false

# Grok X live search. Required for X social narrative analysis.
XAI_API_KEY=
GROK_MODEL=grok-3-mini
GROK_QUERY_DAYS=2

# Discord bot private mode. The bot only responds in this guild/channel
# and only to these comma-separated user IDs.
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_GUILD_ID=
DISCORD_ALLOWED_CHANNEL_ID=
DISCORD_ALLOWED_USER_IDS=

# Optional webhook notifications. Webhook only posts reports; it cannot chat.
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
